# Contact form — used by app/api/send-email/route.js
# Copy to .env.local for local development (never commit real values) and set the same
# variables in the hosting dashboard (Vercel → Project → Settings → Environment Variables).
#
# If SMTP_HOST, SMTP_USER or SMTP_PASS is missing, the API answers
# 503 { "success": false, "code": "not_configured" } and the form should point visitors
# to the email address instead.

# SMTP server, e.g. smtp.gmail.com
SMTP_HOST=

# 587 = STARTTLS (default when empty), 465 = implicit TLS
SMTP_PORT=587

# SMTP login. Also used as the sender address ("Portfolio contact form" <SMTP_USER>).
SMTP_USER=

# SMTP password.
# Gmail / Google Workspace: this must be an App Password (Google Account → Security →
# 2-Step Verification → App passwords), not the account's normal password.
SMTP_PASS=

# Inbox that receives enquiries. Optional — defaults to site.email in content/site.js.
CONTACT_TO=
